# The severance proxy image: the pinned glibc base carrying the pinned Bun
# binary and this repository's own proxy source. Both bases are digest-pinned
# in support/interop-images.toml, which is the one place their references are
# named; nothing here restates them.

FROM docker.io/library/debian@sha256:f324c7ff54321e8d9c588493a20244965938ce0aa50bbd1022d38010e9ffc4b1

# The pinned Bun binary, copied from the preparation context: the same bytes
# scripts/verify_tooling checks against the pinned digest, so the proxy runs
# on exactly the runtime the harness itself is verified against, byte for
# byte. The build context is the repository root.
COPY .tooling/bun-linux-x64/bun /usr/local/bin/bun

# The proxy's own source, carried into the image so the container starts it
# directly and no mount of harness internals is needed at run time.
COPY src/harness/severance-proxy.ts /opt/severance-proxy/severance-proxy.ts
COPY src/harness/http-response-status.ts /opt/severance-proxy/http-response-status.ts
COPY src/harness/forgery-protection.ts /opt/severance-proxy/forgery-protection.ts

ENTRYPOINT ["/usr/local/bin/bun", "/opt/severance-proxy/severance-proxy.ts"]
