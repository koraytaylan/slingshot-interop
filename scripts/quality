#!/usr/bin/env bash
# SPDX-License-Identifier: MIT OR Apache-2.0
# Copyright 2026 Koray Taylan Davgana

# The self gate. It takes no argument, runs every stage every time, and
# fetches nothing: each stage that needs a prepared input verifies it offline
# and refuses naming the one command that prepares it. The stages are fixed —
# verify the pinned tooling, verify the locked dependency cache, install
# offline from it, type check with no error suppressed, run the whole unit
# suite — so a pass means the same thing on every machine.

set -euo pipefail

if [ "$#" -gt 0 ]; then
echo "scripts/quality takes no argument; it runs every stage every time" >&2
exit 1
fi

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "${REPO_ROOT}"

BUN="${REPO_ROOT}/.tooling/bun-linux-x64/bun"

# Stage 1: the pinned tooling. scripts/verify_tooling refuses a missing or
# modified binary by naming scripts/prepare_tooling.
echo "quality: verifying the pinned tooling"
scripts/verify_tooling

# Stage 2: the locked dependency cache. scripts/verify_locked_dependency_cache
# refuses a missing or modified cache by naming
# scripts/prepare_locked_dependency_cache.
echo "quality: verifying the locked dependency cache"
scripts/verify_locked_dependency_cache

# Stage 3: install offline from the verified cache. It never names a
# registry; with the cache refused above, this stage cannot be reached
# unfed.
echo "quality: installing offline from the locked dependency cache"
"${BUN}" install --frozen-lockfile --offline --cache-dir "${REPO_ROOT}/.dependency-cache" >/dev/null

# Stage 4: the type check. Every diagnostic is an error here: no error is
# suppressed (no --skipLibCheck override, no filtering, no exit-code
# tolerance).
echo "quality: running the type check"
"${BUN}" "${REPO_ROOT}/node_modules/typescript/bin/tsc" --noEmit -p "${REPO_ROOT}/tsconfig.json"

# Stage 5: the whole unit suite, every discovered test file, no filter and
# no exclusion.
echo "quality: running the unit suite"
"${BUN}" test

echo "quality: every stage passed"