#!/usr/bin/env bun
// SPDX-License-Identifier: MIT OR Apache-2.0
// Copyright 2026 Koray Taylan Davgana

import { readFileSync } from "node:fs";
import { join } from "node:path";
import { runInterop } from "../src/run/orchestration.ts";
import { readSideDocument, resolveSide } from "../src/sides/pinning.ts";
import { writeReport } from "../src/run/report.ts";

const baseDirectory = process.cwd();
const imagesToml = readFileSync(join(baseDirectory, "support/interop-images.toml"), "utf8");
const images = Bun.TOML.parse(imagesToml);

// Map the TOML sections to the identifier format expected by runInterop.
// A bare digest inspects nothing locally (Podman resolves "sha256:..." only
// against digests of untagged image IDs), so the pinned image is named the
// way the verification names it: name@digest.
const imageIdentifiers: Record<string, { readonly identifier: string }> = {
	"tier-sling": { identifier: `${images["tier-sling"].name}@${images["tier-sling"].identifier}` },
	"client-runner": { identifier: `${images["client-runner"].name}@${images["client-runner"].identifier}` },
	"severance-proxy": { identifier: `${images["severance-proxy"].name}@${images["severance-proxy"].identifier}` },
};

const outcome = await runInterop(baseDirectory, {
	images: imageIdentifiers,
	// Progress goes to standard error, one line per step, while the run is
	// running. A run takes minutes and says nothing on standard output until
	// it has finished, so a reader watching a terminal needs the steps as they
	// happen; keeping them off standard output leaves the report the only
	// thing on it, which is what something parsing this command reads.
	progress: (line) => console.error(line),
});

if (!outcome.ok) {
	if (outcome.reason === "SIDE_UNRESOLVED") {
		const steps = outcome.refusals
			.map((r) => `side "${r.side}" is unresolved: ${r.ownerStep}`)
			.join("; ");
		console.error(`Run refused: ${steps}`);
	} else {
		console.error(`Run failed: ${outcome.message}`);
	}
	process.exit(1);
}

// Extract label and scenarios from report string
const lines = outcome.report.split("\n");
const label = lines[0].replace("Run label: ", "");
const scenarios = [];
let recordingScenarios = false;
for (const line of lines) {
	if (line === "Scenarios:") {
		recordingScenarios = true;
		continue;
	}
	if (recordingScenarios && line.startsWith("  - ")) {
		const content = line.substring(4);
		const [scenario, result] = content.split(": ");
		if (result === "ok") {
			scenarios.push({ scenario, ok: true });
		} else {
			scenarios.push({ 
				scenario, 
				ok: false, 
				message: result.startsWith("failed (") ? result.substring(8, result.length - 1) : result 
			});
		}
	}
}

// Resolve sides (they must be resolved since runInterop succeeded)
const slingshotDoc = readSideDocument(join(baseDirectory, "support/slingshot-side.toml"));
const agentDoc = readSideDocument(join(baseDirectory, "support/agent-side.toml"));
const slingshotRes = resolveSide("slingshot", slingshotDoc, baseDirectory);
const agentRes = resolveSide("agent", agentDoc, baseDirectory);

if (slingshotRes.refused || agentRes.refused) {
	console.error("Unexpected side resolution failure after successful run");
	process.exit(1);
}

// Prepare image data
const imagesReport: Record<string, { identifier: string; digest: string }> = {
	"tier-sling": { 
		identifier: images["tier-sling"].identifier, 
		digest: images["tier-sling"].digest || images["tier-sling"].identifier 
	},
	"client-runner": { 
		identifier: images["client-runner"].identifier, 
		digest: images["client-runner"].digest || images["client-runner"].identifier 
	},
	"severance-proxy": { 
		identifier: images["severance-proxy"].identifier, 
		digest: images["severance-proxy"].digest || images["severance-proxy"].identifier 
	},
};

// Write report to baseDirectory to ensure it survives teardown
await writeReport(baseDirectory, {
	label,
	sides: {
		slingshot: slingshotRes.resolved,
		agent: agentRes.resolved,
	},
	images: imagesReport,
	scenarios,
});

console.log(outcome.report);
process.exit(0);
