import { readFileSync } from "node:fs";
import { join } from "node:path";
import { runInterop } from "../src/run/orchestration.ts";
import { stderrProgress } from "../src/run/progress.ts";
import { reportExitCode, writeReport, writeRefusalReport } from "../src/run/report.ts";

const baseDirectory = process.cwd();
let stage = "prepare-inputs";

async function execute(): Promise<number> {
	const imagesToml = readFileSync(join(baseDirectory, "support/interop-images.toml"), "utf8");
	const images = Bun.TOML.parse(imagesToml) as Record<string, { name: string; identifier: string }>;
	function imageIdentifier(name: string): { readonly identifier: string } {
		const image = images[name];
		if (image === undefined) {
			throw new Error(`Missing prepared image: ${name}`);
		}
		return { identifier: `${image.name}@${image.identifier}` };
	}

	const options = {
		images: {
			"tier-sling": imageIdentifier("tier-sling"),
			"client-runner": imageIdentifier("client-runner"),
			"severance-proxy": imageIdentifier("severance-proxy"),
		},
		progress: stderrProgress,
	};
	stage = "orchestration";
	const outcome = await runInterop(baseDirectory, options);

	if (!outcome.ok) {
		if (outcome.reason === "SIDE_UNRESOLVED") {
			const steps = outcome.refusals
				.map((r) => `side "${r.side}" is unresolved: ${r.ownerStep}`)
				.join("; ");
			console.error(`Run refused: ${steps}`);
			await writeRefusalReport(baseDirectory, "side-resolution", steps);
		} else {
			if (outcome.data !== undefined) await writeReport(baseDirectory, outcome.data);
			else await writeRefusalReport(baseDirectory, "setup", outcome.message);
			console.error(`Run failed: ${outcome.message}`);
		}
		return 1;
	}

	// Keep the identities resolved before execution and complete diagnostics.
	// Human-readable output is never parsed back into evidence.
	await writeReport(baseDirectory, outcome.data);
	console.log(outcome.report);
	return reportExitCode(outcome.data);
}

try {
	process.exit(await execute());
} catch (failure) {
	const message = failure instanceof Error ? failure.message : String(failure);
	console.error(`Run failed during ${stage}: ${message}`);
	try { await writeRefusalReport(baseDirectory, stage, message); }
	catch (reportFailure) {
		console.error(`Refusal report could not be written: ${reportFailure instanceof Error ? reportFailure.message : String(reportFailure)}`);
	}
	process.exit(1);
}
